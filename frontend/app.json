{
  "expo": {
    "name": "BizMate",
    "slug": "bizmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1A2332"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bizmate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2332"
      },
      "package": "com.bizmate.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "bizmate",
    "plugins": ["expo-router"]
  }
}
